{
  "name": "study-surfers-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test:unit": "node --import ./scripts/node-test-resolve.mjs --test \"src/**/*.test.ts\"",
    "generate:contract": "openapi-typescript ../contract/openapi.json -o ../contract/api-types.ts",
    "assets": "node scripts/optimize-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource-variable/shantell-sans": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@fontsource/rubik-wet-paint": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.2.0",
    "howler": "^2.2.4",
    "katex": "^0.18.4",
    "lucide-react": "^1.18.0",
    "maath": "^0.10.8",
    "postprocessing": "^6.39.5",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.3.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.63.0",
    "@types/howler": "^2.2.13",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.0.0",
    "meshoptimizer": "^1.3.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.0",
    "vite": "^8.0.0"
  }
}
